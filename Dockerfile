# 1. نستخدم نسخة Node.js الرسمية والمستقرة
FROM node:18

# 2. نحدد مجلد العمل داخل السيرفر السحابي
WORKDIR /usr/src/app

# 3. ننسخ ملف الحزم لتثبيت المتطلبات الخفيفة للموقع
COPY package*.json ./
RUN npm install

# 4. ننسخ الأكواد الصافية لموقعك وسيلفبوت الديسكورد
COPY . .

# 5. نفتح البورت الافتراضي للوحة التحكم
EXPOSE 8080

# 6. أمر التشغيل السريع والمباشر لموقعك
CMD ["npm", "start"]
